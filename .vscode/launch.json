{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "socaity_sdk: Create Socaity SDK",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/socaity/core/socaity_service_registry.py",
            "console": "integratedTerminal",
            "env": {
                "PYTHONPATH": "${workspaceFolder};${workspaceFolder}/../fastCloud;${workspaceFolder}/../media-toolkit;${workspaceFolder}/../fastsdk;${workspaceFolder}/../meseex;${workspaceFolder}/../APIPodRegistry;${workspaceFolder}/../socaity_schemas;${workspaceFolder}/../socaity-cli"
            }
        },
        {
            "name": "socaity_sdk: Core bundle",
            "type": "debugpy",
            "request": "launch",
            "module": "pytest",
            "args": ["test/bundle/test_core.py", "-v", "-s"],
            "console": "integratedTerminal",
            "env": {
                "PYTHONPATH": "${workspaceFolder};${workspaceFolder}/../fastCloud;${workspaceFolder}/../media-toolkit;${workspaceFolder}/../fastsdk;${workspaceFolder}/../meseex;${workspaceFolder}/../APIPodRegistry;${workspaceFolder}/../socaity_schemas;${workspaceFolder}/../socaity-cli"
            }
        },
        {
            "name": "socaity_sdk: Replicate (platform)",
            "type": "debugpy",
            "request": "launch",
            "module": "pytest",
            "args": ["test/test_replicate.py", "-v", "-s"],
            "console": "integratedTerminal",
            "env": {
                "PYTHONPATH": "${workspaceFolder};${workspaceFolder}/../fastCloud;${workspaceFolder}/../media-toolkit;${workspaceFolder}/../fastsdk;${workspaceFolder}/../meseex;${workspaceFolder}/../APIPodRegistry;${workspaceFolder}/../socaity_schemas;${workspaceFolder}/../socaity-cli"
            }
        },
        {
            "name": "Python: Test Speechcraft (manual)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/test/manual/test_speechcraft.py",
            "console": "integratedTerminal",
            "env": {
                "PYTHONPATH": "${workspaceFolder};${workspaceFolder}/../fastCloud;${workspaceFolder}/../media-toolkit;${workspaceFolder}/../fastsdk;${workspaceFolder}/../meseex;${workspaceFolder}/../APIPodRegistry;${workspaceFolder}/../socaity_schemas;${workspaceFolder}/../socaity-cli"
            }
        },
        {
            "name": "Python: Test Face2Face (manual)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/test/manual/test_face2face.py",
            "console": "integratedTerminal",
            "env": {
                "PYTHONPATH": "${workspaceFolder};${workspaceFolder}/../fastCloud;${workspaceFolder}/../media-toolkit;${workspaceFolder}/../fastsdk;${workspaceFolder}/../meseex;${workspaceFolder}/../APIPodRegistry;${workspaceFolder}/../socaity_schemas;${workspaceFolder}/../socaity-cli"
            }
        }
    ]
}
